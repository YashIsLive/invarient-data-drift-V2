{
  "name": "diamonds",
  "title": "Diamond price model",
  "description": "A diamond wholesaler suggests a price for every stone from its measurements. A grading machine weighs each stone and measures its length, width and depth. Each day, 200 stones are graded and priced.",
  "csv": "datasets/diamonds.csv",
  "target": "price",
  "monitored": ["carat", "x", "y", "z", "depth", "table"],
  "context": ["cut", "color", "clarity"],
  "time_column": null,
  "log_features": ["carat", "x", "y", "z"],
  "batch_size": 200,
  "shift_driver": "carat",
  "shift_story": "holiday season, customers buy bigger stones",
  "batch_word": "day",
  "labels": {"carat": "Weight", "x": "Length", "y": "Width", "z": "Depth",
             "depth": "Depth %", "table": "Table %", "price": "Price"},
  "units": {"carat": "ct", "x": "mm", "y": "mm", "z": "mm", "depth": "%", "table": "%", "price": "$"},
  "scenarios": [
    {"title": "An ordinary month", "batches": 24, "events": []},
    {"title": "Holiday season: customers buy bigger stones", "batches": 24,
     "events": [{"kind": "shift", "start": 6, "strength": 1.0}]},
    {"title": "The length gauge reads 3% high", "batches": 24,
     "events": [{"kind": "fault", "start": 10, "feature": "x", "fault": "percent", "amount": 3}]},
    {"title": "Holiday season, then the length gauge goes wrong (main demo)", "batches": 24,
     "events": [{"kind": "shift", "start": 5, "strength": 1.0},
                {"kind": "fault", "start": 13, "feature": "x", "fault": "percent", "amount": 3}]},
    {"title": "The scale drifts: weight reads 6% low", "batches": 24,
     "events": [{"kind": "fault", "start": 10, "feature": "carat", "fault": "percent", "amount": -6}]},
    {"title": "Width suddenly recorded in centimetres", "batches": 24,
     "events": [{"kind": "fault", "start": 10, "feature": "y", "fault": "unit", "amount": 0.1}]},
    {"title": "The depth probe comes loose (noisy readings)", "batches": 24,
     "events": [{"kind": "fault", "start": 10, "feature": "z", "fault": "noise", "amount": 3}]},
    {"title": "Table % goes missing for four days", "batches": 24,
     "events": [{"kind": "fault", "start": 10, "end": 13, "feature": "table", "fault": "missing", "amount": 60}]}
  ]
}
